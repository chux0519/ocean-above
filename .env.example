# Copy to .env and fill in. Names only here; never commit .env.

# OpenAI-compatible LLM endpoint (demo: DeepSeek flash)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# none | low | high | max (default high); `omit` for servers that do not know the field
LLM_REASONING_EFFORT=
# Optional: path of the .env file the backend reads when the variables are not in the environment
OCEAN_ENV_FILE=

# Development login (one fixed account; disabled on the public demo)
DEV_AUTH_USER=
DEV_AUTH_PASSWORD=

# Set to 1 behind HTTPS (the demo sits behind Cloudflare); leave empty for http://localhost
COOKIE_SECURE=

# Signing keys; unset = random per process (a restart signs everyone out / invalidates open confirm buttons)
SESSION_SECRET=
NONCE_SECRET=

# Host port for the single public entry (127.0.0.1:OCEAN_PORT). Default 3000.
OCEAN_PORT=3000

# Google Sign-In (ID token only; the client ID is not secret). Empty = Google login hidden.
GOOGLE_CLIENT_ID=
# Invite codes for reviewers, comma-separated. Append only: the position is part of the account key.
INVITE_CODES=
# Proxies whose CF-Connecting-IP / X-Forwarded-For are trusted for login throttling (default: loopback + private ranges)
TRUSTED_PROXIES=
# Usage limits (UTC day)
DAILY_MESSAGES_PER_USER=50
DAILY_TOKEN_BUDGET=2000000
# Outbound proxy for the api container if it cannot reach www.googleapis.com / the LLM directly
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,api,web
