# Copy to .env and fill in. Names only here; never commit .env.

# OpenAI-compatible LLM endpoint (demo: DeepSeek flash)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Development login (one fixed account; disabled on the public demo)
DEV_AUTH_USER=
DEV_AUTH_PASSWORD=

# Set to 1 behind HTTPS (the demo sits behind Cloudflare); leave empty for http://localhost
COOKIE_SECURE=

# Host port for the single public entry (127.0.0.1:OCEAN_PORT). Default 3000.
OCEAN_PORT=3000
