# Single public entry (compose service `proxy`, published on 127.0.0.1 only; Cloudflare Tunnel forwards to it).
# Plain HTTP inside the compose network: TLS is terminated by Cloudflare.
:80 {
	# /api/* (including SSE streams) and the health probe go to the API.
	@api path /api/* /health
	handle @api {
		request_body {
			max_size 64KB
		}
		reverse_proxy api:8000 {
			# Do not buffer: SSE events must reach the browser as they are produced.
			flush_interval -1
		}
	}

	# Talk slides: static files from docs/talk (mounted read-only). Not linked from the app, not indexed.
	redir /talk /talk/ 308
	handle_path /talk/* {
		header X-Robots-Tag "noindex, nofollow"
		@private path /tools/* /png/* *.py *.sh *.md
		respond @private 404
		root * /srv/talk
		rewrite / /vibe-process.html
		file_server
	}

	# Everything else is the web app.
	handle {
		reverse_proxy web:3000
	}
}
